--[[
    Beryl Device - Perk Artifact Recharger

    Follows HF Gadgets pattern: 
    - State via hf_obj_manager (not wrapper variables)
    - Standalone functions for business logic
    - Wrapper only for update loop and physics

    State machine: idle → charging (60s) → cooldown → ready → idle
]]

-- State helpers (mirrors bind_trading_computer pattern)
local function get_data(obj_id)
    if not obj_id or not hf_obj_manager then return {} end
    return hf_obj_manager.get_data(obj_id) or {}
end

local function set_data(obj_id, fields)
    if not obj_id or not hf_obj_manager then return end
    hf_obj_manager.update_data(obj_id, fields)
end

local function get_actor()
    return db and db.actor or nil
end

--------------------------------------------------------------------------------
-- Business logic functions (standalone, called by wrapper & UI)
--------------------------------------------------------------------------------

function is_perk_artifact(item)
    if not item then return false end
    local ok_sec, section = pcall(function() return item:section() end)
    if not ok_sec or not section then return false end
    local kind = SYS_GetParam(0, section, "kind", "")
    return kind == "i_arty_junk"
end

function find_perk_artifacts_in_inventory()
    local actor = get_actor()
    if not actor then return {} end

    local result = {}
    
    pcall(function()
        actor:iterate_inventory(function(npc, item)
            if not item then return end
            if not is_perk_artifact(item) then return end
            
            local ok_sec, section = pcall(function() return item:section() end)
            if not ok_sec or not section then return end
            
            local ok_cond, condition = pcall(function() return item:condition() end)
            
            table.insert(result, {
                object = item,
                section = section,
                condition = (ok_cond and condition) or 1.0
            })
        end, actor)
    end)
    
    return result
end

function get_device_state(obj_id)
    local data = get_data(obj_id)
    return data.device_state or "idle"
end

function get_artifact_info(obj_id)
    local data = get_data(obj_id)
    return data.artifact_section, data.original_condition
end

function start_charging(obj_id, section, condition)
    local actor = get_actor()
    if not section or not actor then return end

    -- Block charging if cooldown timer is still active (player retrieved early)
    local data = get_data(obj_id)
    if data.cooldown_timer and data.cooldown_timer > 0 then
        if actor then
            actor:give_talk_message("st_zad_beryl_cooldown", nil, nil, nil, nil)
        end
        return
    end

    -- Find the artifact first, then remove it (iterate_inventory breaks if you remove during iteration)
    local found_item = nil
    actor:iterate_inventory(function(npc, item)
        if found_item then return end
        if not item then return end
        local ok, sec = pcall(function() return item:section() end)
        if not ok or sec ~= section then return end
        if condition ~= nil and math.abs(item:condition() - condition) >= 0.01 then return end
        found_item = item
    end, actor)
    
    if found_item then
        -- Release the item via its server object (remove_item doesn't exist in this engine)
        local se_obj = alife_object(found_item:id())
        if se_obj then
            alife():release(se_obj, true)
        end
    end

    set_data(obj_id, {
        device_state = "charging",
        charge_timer = 60,
        cooldown_timer = 0,
        artifact_section = section,
        original_condition = condition or 1.0
    })

    local obj = level.object_by_id(obj_id)
    if obj then
        local binder = obj:binded_object()
        if binder and binder.wrapper and binder.wrapper.start_charging_effects then
            binder.wrapper:start_charging_effects()
        end
    end
end

function return_artifact_to_player(obj_id, cond)
    local actor = get_actor()
    if not actor then return end

    local data = get_data(obj_id)
    local section = data.artifact_section
    if not section then return end

    alife_create_item(section, actor, {cond = cond or 1.0})

    -- Clean up anomalies before returning artifact
    local obj = level.object_by_id(obj_id)
    if obj then
        local binder = obj:binded_object()
        if binder and binder.wrapper and binder.wrapper.stop_charging_effects then
            binder.wrapper:stop_charging_effects()
        end
    end

    if hf_obj_manager then
        hf_obj_manager.set_data(obj_id, {
            device_state = "idle",
            charge_timer = 0,
            artifact_section = nil,
            original_condition = nil
        })
    end

    if obj then
        obj:set_tip_text(game.translate_string("st_interact"))
    end

    actor:give_talk_message("st_zad_beryl_retrieved", nil, nil, nil, nil)
end

function get_anomaly_type_for_artifact(section)
    if not section then return "zone_mine_electric", "zone_field_radioactive" end

    local ini = system_ini()
    local det_particles = nil
    if ini then
        det_particles = ini:r_string_ex(section, "det_show_particles")
    end

    if not det_particles then return "zone_mine_electric", "zone_field_radioactive" end

    det_particles = string.lower(det_particles)

    if string.find(det_particles, "electra") then
        return "zone_mine_electra", "zone_field_radioactive_strong"
    elseif string.find(det_particles, "thermal") then
        return "zone_zharka_static_average", "zone_field_thermal_strong"
    elseif string.find(det_particles, "acidic") then
        return "zone_mine_chemical_average", "zone_field_acidic_strong"
    end

    return "zone_mine_electra", "zone_field_radioactive_strong"
end

--------------------------------------------------------------------------------
-- Init function for script_binding in LTX
--------------------------------------------------------------------------------
function init(obj)
    obj:bind_object(beryl_device_wrapper(obj).binder)
end

--------------------------------------------------------------------------------
-- Wrapper: handles update loop, physics, anomaly effects
-- Uses standard base_binder (via super(obj)) -- no custom binder,
-- interaction is handled entirely through ui_on_interaction LTX property.
--------------------------------------------------------------------------------
class "beryl_device_wrapper" (bind_hf_base.hf_binder_wrapper)

function beryl_device_wrapper:__init(obj) super(obj)

    self.anomaly_radius = 30
    self.anomaly_count = 30
    self.anomaly_ids = {}
    self.charge_sound = nil
    self.charge_sound_pos = nil
    self.cooldown_sound = nil
    self.charge_stage = 0
    self.field_spawned = false

    local id = self.object:id()
    local data = get_data(id)
    if not data or not data.device_state then
        set_data(id, {
            device_state = "idle",
            charge_timer = 0,
            cooldown_timer = 0,
            artifact_section = nil,
            original_condition = nil
        })
    end

    self.object:set_tip_text(game.translate_string("st_interact"))
end

function beryl_device_wrapper:update(delta)
    -- Convert delta to seconds (engine passes milliseconds, see alarm_system_wrapper pattern)
    local dt = delta
    if dt > 1.0 then dt = dt / 1000.0 end
    
    if not self.object then return end
    local id = self.object:id()
    local data = get_data(id)
    local state = data.device_state or "idle"

    -- Always count down cooldown timer (blocks new charges even after retrieval)
    if data.cooldown_timer and data.cooldown_timer > 0 and state ~= "cooldown" then
        data.cooldown_timer = data.cooldown_timer - dt
        if data.cooldown_timer <= 0 then data.cooldown_timer = 0 end
        set_data(id, { cooldown_timer = data.cooldown_timer })
    end

    if state == "charging" then
        data.charge_timer = (data.charge_timer or 60) - dt

        -- Keep charge sound position synced with device position
        if self.charge_sound and self.charge_sound_pos then
            local current_pos = self.object:position()
            if current_pos then
                self.charge_sound_pos = current_pos
                pcall(function() self.charge_sound:set_position(current_pos) end)
            end
        end

        -- Staged anomaly mine spawning, field zone spawns last at t=30
        if self.charge_stage < 6 and data.charge_timer <= 60 - (self.charge_stage + 1) * 5 then
            self:spawn_charge_stage(self.charge_stage)
            self.charge_stage = self.charge_stage + 1
        elseif self.charge_stage == 6 and data.charge_timer <= 30 and not self.field_spawned then
            self:spawn_field_zone()
        end

        if data.charge_timer <= 0 then
            local orig_cond = data.original_condition or 1.0
            local cooldown = 30

            set_data(id, {
                device_state = "cooldown",
                charge_timer = 0,
                cooldown_timer = cooldown,
                artifact_section = data.artifact_section,
                original_condition = orig_cond
            })

            -- Stop charge sound, start cooldown loop sound
            if self.charge_sound then
                pcall(function() self.charge_sound:stop() end)
                self.charge_sound = nil
                self.charge_sound_pos = nil
            end
            local cpos = self.object:position()
            if cpos then
                local ok_cd, cd_snd = pcall(function() return sound_object("zad\\test2") end)
                if ok_cd and cd_snd then
                    self.cooldown_sound = cd_snd
                    pcall(function()
                        self.cooldown_sound:play_at_pos(self.object, cpos, 0, sound_object.looped)
                        self.cooldown_sound.min_distance = 1.0
                        self.cooldown_sound.max_distance = 100.0
                        self.cooldown_sound.volume = 1.0
                    end)
                end
            end

            self.object:set_tip_text(game.translate_string("st_zad_beryl_cooldown"))
        else
            set_data(id, { charge_timer = data.charge_timer })
        end

    elseif state == "cooldown" then
        data.cooldown_timer = (data.cooldown_timer or 0) - dt

        -- Keep cooldown sound position synced with device position
        if self.cooldown_sound then
            local current_pos = self.object:position()
            if current_pos then
                pcall(function() self.cooldown_sound:set_position(current_pos) end)
            end
        end

        if data.cooldown_timer <= 0 then
            -- Cooldown over, device ready for manual retrieval at original condition
            -- Anomalies remain until player retrieves the artifact
            set_data(id, {
                device_state = "ready",
                charge_timer = 0,
                cooldown_timer = 0,
                artifact_section = data.artifact_section,
                original_condition = data.original_condition
            })

            self.object:set_tip_text(game.translate_string("st_zad_beryl_retrieve"))
        else
            set_data(id, { cooldown_timer = data.cooldown_timer })
        end
    end
end

function beryl_device_wrapper:start_charging_effects()
    local device_pos = self.object:position()

    -- Start the looping charge sound
    if device_pos then
        local ok_snd, snd = pcall(function() return sound_object("zad\\test1") end)
        if ok_snd and snd then
            self.charge_sound = snd
            self.charge_sound_pos = device_pos
            pcall(function()
                self.charge_sound:play_at_pos(self.object, device_pos, 0, sound_object.looped)
                self.charge_sound.min_distance = 1.0
                self.charge_sound.max_distance = 100.0
                self.charge_sound.volume = 1.0
            end)
        end
    end

    -- Reset staged anomaly spawning tracking
    self.charge_stage = 0
    self.field_spawned = false

    pcall(function() self.object:set_tip_text(game.translate_string("st_zad_beryl_charging")) end)
end

--------------------------------------------------------------------------------
-- Spawn anomalies for a specific ring stage (2m min offset from device)
-- stage 0: 2-7m, 1: 7-12m, 2: 12-17m, 3: 17-22m, 4: 22-27m, 5: 27-32m
--------------------------------------------------------------------------------
function beryl_device_wrapper:spawn_charge_stage(stage)
    local device_pos = self.object:position()
    if not device_pos then return end

    local alife_obj = alife()
    if not alife_obj then return end

    local data = get_data(self.object:id())
    local primary_type, _ = get_anomaly_type_for_artifact(data.artifact_section)

    local lvid = level.vertex_id(device_pos)
    local gvid = self.object:game_vertex_id()

    local inner_radius = stage * 5 + 2
    local outer_radius = (stage + 1) * 5 + 2

    -- Helper to spawn an anomaly with proper zone data (required to prevent nearest_s crash in CalcDistanceTo)
    local function spawn_anom(anom_type, pos, spawn_lvid)
        if SYS_GetParam(0, anom_type, "class", "") == "" then return nil end

        local se_obj = alife_obj:create(anom_type, pos, spawn_lvid, gvid)
        if not se_obj then return nil end

        -- Set zone data (required to prevent nearest_s crash in CalcDistanceTo)
        pcall(function()
            local zdata = utils_stpk.get_anom_zone_data(se_obj)
            if zdata then
                zdata.shapes[1] = zdata.shapes[1] or {}
                zdata.shapes[1].shtype = 0
                zdata.shapes[1].offset = vector():set(0, 0, 0)
                zdata.shapes[1].center = vector():set(0, 0, 0)
                zdata.shapes[1].radius = 2.0 + math.random() * 2.0
                utils_stpk.set_anom_zone_data(zdata, se_obj)
            end
        end)

        return se_obj
    end

    -- Elemental count scales with distance: 2,3,4,5,6,7
    local elem_count = stage + 2
    for i = 1, elem_count do
        local angle = (i / elem_count) * 2 * math.pi + math.random() * 0.3
        local dist = inner_radius + math.random() * (outer_radius - inner_radius)

        local pos = vector():set(
            device_pos.x + math.cos(angle) * dist,
            device_pos.y,
            device_pos.z + math.sin(angle) * dist
        )

        local spawn_lvid = level.vertex_id(pos)
        if spawn_lvid == 65535 then spawn_lvid = lvid end

        local vertex_pos = level.vertex_position(spawn_lvid)
        if vertex_pos then
            pos.y = vertex_pos.y
        end

        local se_obj = spawn_anom(primary_type, pos, spawn_lvid)
        if se_obj then
            table.insert(self.anomaly_ids, se_obj.id)
        end
    end

    -- Gravitational count scales with distance: 1,1,2,2,3,3
    local grav_count = math.floor(stage / 2) + 1
    for i = 1, grav_count do
        local angle = (i / grav_count) * 2 * math.pi + math.random() * 0.5
        local dist = inner_radius + math.random() * (outer_radius - inner_radius)

        local grav_type = (stage % 2 == 0)
            and "zone_mine_springboard"
            or "zone_mine_vortex"

        local pos = vector():set(
            device_pos.x + math.cos(angle) * dist,
            device_pos.y,
            device_pos.z + math.sin(angle) * dist
        )

        local spawn_lvid = level.vertex_id(pos)
        if spawn_lvid == 65535 then spawn_lvid = lvid end

        local vertex_pos = level.vertex_position(spawn_lvid)
        if vertex_pos then
            pos.y = vertex_pos.y
        end

        local se_obj = spawn_anom(grav_type, pos, spawn_lvid)
        if se_obj then
            table.insert(self.anomaly_ids, se_obj.id)
        end
    end
end

--------------------------------------------------------------------------------
-- Spawn the field zone at device position (triggered at t=30)
--------------------------------------------------------------------------------
function beryl_device_wrapper:spawn_field_zone()
    local device_pos = self.object:position()
    if not device_pos then return end

    local alife_obj = alife()
    if not alife_obj then return end

    local data = get_data(self.object:id())
    local _, field_type = get_anomaly_type_for_artifact(data.artifact_section)

    local lvid = level.vertex_id(device_pos)
    local gvid = self.object:game_vertex_id()

    -- Adjust field zone Y to ground level
    local field_pos = vector():set(device_pos.x, device_pos.y, device_pos.z)
    pcall(function()
        local fv_pos = level.vertex_position(lvid)
        if fv_pos then
            field_pos.y = fv_pos.y
        end
    end)

    if SYS_GetParam(0, field_type, "class", "") == "" then return end

    local se_field = alife_obj:create(field_type, field_pos, lvid, gvid)
    if not se_field then return end

    -- Fully initialize zone shape data (required to prevent nearest_s crash in CalcDistanceTo)
    pcall(function()
        local zdata = utils_stpk.get_anom_zone_data(se_field)
        if zdata then
            zdata.shapes[1] = zdata.shapes[1] or {}
            zdata.shapes[1].shtype = 0
            zdata.shapes[1].offset = vector():set(0, 0, 0)
            zdata.shapes[1].center = vector():set(0, 0, 0)
            zdata.shapes[1].radius = 32.0
            utils_stpk.set_anom_zone_data(zdata, se_field)
        end
    end)

    table.insert(self.anomaly_ids, se_field.id)
    self.field_spawned = true
end

function beryl_device_wrapper:stop_charging_effects()
    -- Disable anomalies via game object (matching DAO pattern), then release
    local alife_obj = alife()
    for _, id in ipairs(self.anomaly_ids) do
        -- First disable via game object (disable_anomaly exists on game_object, not server)
        local g_obj = level.object_by_id(id)
        if g_obj then
            pcall(function() g_obj:disable_anomaly() end)
        end
        -- Then release via server object
        if alife_obj then
            local se_obj = alife_obj:object(id)
            if se_obj then
                pcall(function() alife_obj:release(se_obj, true) end)
            end
        end
    end
    self.anomaly_ids = {}

    if self.charge_sound then
        pcall(function() self.charge_sound:stop() end)
        self.charge_sound = nil
        self.charge_sound_pos = nil
    end

    if self.cooldown_sound then
        pcall(function() self.cooldown_sound:stop() end)
        self.cooldown_sound = nil
    end
end

function beryl_device_wrapper:play_sound(path)
    local ok, snd = pcall(function() return sound_object(path) end)
    if ok and snd then
        local pos = self.object:position()
        if pos then
            pcall(function() snd:play_at_pos(self.object, pos, 0, sound_object.s3d) end)
        end
    end
    return ok and snd or nil
end

function beryl_device_wrapper:net_spawn(se_abstract)
    if not self.object then return false end
    local ok = true
    if bind_hf_base.hf_binder_wrapper.net_spawn then
        ok = bind_hf_base.hf_binder_wrapper.net_spawn(self, se_abstract)
        if ok == false then return false end
    end

    local phys = self.object:get_physics_shell()
    if phys then phys:freeze() end

    return true
end

function beryl_device_wrapper:net_destroy()
    if not self.object then return end
    self:stop_charging_effects()

    if bind_hf_base.hf_binder_wrapper.net_destroy then
        bind_hf_base.hf_binder_wrapper.net_destroy(self)
    end
end

--------------------------------------------------------------------------------
-- Prevent pickup while charging or when an artifact hasn't been retrieved
--------------------------------------------------------------------------------
function beryl_device_wrapper:pickup()
    local id = self.object:id()
    local data = get_data(id)
    local state = data.device_state or "idle"
    
    -- Cannot pick up while charging
    if state == "charging" then
        if db.actor then
            db.actor:give_talk_message("st_zad_beryl_charging", nil, nil, nil, nil)
        end
        return false
    end
    
    -- Cannot pick up if there's an artifact waiting to be retrieved
    if data.artifact_section then
        if db.actor then
            db.actor:give_talk_message("st_zad_beryl_retrieve", nil, nil, nil, nil)
        end
        return false
    end
    
    -- Clean up any active effects before pickup
    self:stop_charging_effects()
    
    -- Call parent pickup
    return bind_hf_base.hf_binder_wrapper.pickup(self)
end
