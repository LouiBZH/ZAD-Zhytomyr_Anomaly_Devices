--[[
    UI Beryl Device - Interaction dialog for Beryl Device
    Single-mode layout matching ui_trading_computer.script:
    - Artifact list shown directly on open
    - "Charge Artifact" button at bottom
    - "Close" button at bottom
    - No pick up button (handled by game)
]]

local GUI = nil  -- singleton
local last_interact_id = nil   -- guards against double-call from ui_on_interaction + ui_on_simple_interaction
local last_interact_time = 0

--------------------------------------------------------------------------------
-- Main UI class
--------------------------------------------------------------------------------
class "UIBerylDevice" (CUIScriptWnd)

function UIBerylDevice:__init() super()
    self.obj_id = nil
    self.selected_data = nil
    self.artifact_data = {}  -- section -> {section, condition, object}
    
    self:InitControls()
    self:InitCallbacks()
end

function UIBerylDevice:__finalize()
    GUI = nil
end

--------------------------------------------------------------------------------
-- Initialize all UI controls from XML
--------------------------------------------------------------------------------
function UIBerylDevice:InitControls()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)
    
    local xml = CScriptXmlInit()
    xml:ParseFile("ui_beryl_device_dialog")
    
    self.back = xml:InitFrame("background", self)
    self.title_text = xml:InitStatic("title_text", self.back)
    self.status_text = xml:InitStatic("status_text", self.back)
    self.list_frame = xml:InitFrame("list_frame", self.back)
    self.artifact_list = xml:InitListBox("artifact_list", self.list_frame)
    self:Register(self.artifact_list, "artifact_list")
    
    self.btn_charge = xml:Init3tButton("btn_charge", self.back)
    self:Register(self.btn_charge, "btn_charge")
    
    self.btn_close = xml:Init3tButton("btn_close", self.back)
    self:Register(self.btn_close, "btn_close")
end

--------------------------------------------------------------------------------
-- Register button callbacks
--------------------------------------------------------------------------------
function UIBerylDevice:InitCallbacks()
    self:AddCallback("btn_charge", ui_events.BUTTON_CLICKED, 
        self.OnCharge, self)
    self:AddCallback("btn_close", ui_events.BUTTON_CLICKED, 
        self.OnClose, self)
    self:AddCallback("artifact_list", ui_events.LIST_ITEM_CLICKED, 
        self.OnArtifactClicked, self)
end

--------------------------------------------------------------------------------
-- Keyboard handler (ESC to close)
--------------------------------------------------------------------------------
function UIBerylDevice:OnKeyboard(dik, keyboard_action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
    if res == false then
        if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
            if dik == DIK_keys.DIK_ESCAPE then
                self:Close()
                return true
            end
        end
    end
    return res
end

--------------------------------------------------------------------------------
-- Show the dialog
--------------------------------------------------------------------------------
function UIBerylDevice:TestAndShow(obj_id)
    self.obj_id = obj_id
    self.selected_data = nil
    
    -- Update status text
    self:UpdateStatusText()
    
    -- Populate artifact list
    self:PopulateArtifactList()
    
    -- Disable charge button until artifact selected
    pcall(function() self.btn_charge:Enable(false) end)
    
    pcall(function() self:ShowDialog(true) end)
    pcall(function() Register_UI("UIBerylDevice", "ui_beryl_device") end)
end

--------------------------------------------------------------------------------
-- Update status text based on current device state
--------------------------------------------------------------------------------
function UIBerylDevice:UpdateStatusText()
    if not self.obj_id then return end
    
    local state = beryl_device.get_device_state(self.obj_id)
    local text_id = "st_zad_beryl_ui_status_idle"
    
    if state == "charging" then
        text_id = "st_zad_beryl_ui_status_charging"
    elseif state == "cooldown" then
        text_id = "st_zad_beryl_ui_status_cooldown"
    elseif state == "ready" then
        text_id = "st_zad_beryl_ui_status_ready"
    end
    
    pcall(function() self.status_text:SetText(game.translate_string(text_id)) end)
end

--------------------------------------------------------------------------------
-- Custom list item class
--------------------------------------------------------------------------------
class "artifact_item" (CUIListBoxItem)

function artifact_item:__init(height) super(height)
    self.art_section = nil
    self.txt = self:GetTextItem()
    self.txt:SetFont(GetFontLetterica16Russian())
    self.txt:SetEllipsis(true)
end

function artifact_item:__finalize()
end

function UIBerylDevice:AddArtifactEntry(entry)
    local item = artifact_item(22)
    item:SetWndSize(vector2():set(400, 22))
    item.art_section = entry.section

    local art_name = self:GetArtifactDisplayName(entry.object, entry.section)
    local condition_pct = math.floor(entry.condition * 100)
    local txt = art_name .. " [" .. condition_pct .. "%]"
    
    item.txt:SetWndPos(vector2():set(0, 0))
    item.txt:SetWndSize(vector2():set(400, 22))
    pcall(function() item.txt:SetText(txt) end)

    self.artifact_list:AddExistingItem(item)
end

--------------------------------------------------------------------------------
-- Populate artifact list
--------------------------------------------------------------------------------
function UIBerylDevice:PopulateArtifactList()
    self.artifact_list:RemoveAll()
    self.selected_data = nil
    self.artifact_data = {}
    
    local artifacts = beryl_device.find_perk_artifacts_in_inventory() or {}
    
    for _, entry in ipairs(artifacts) do
        self.artifact_data[entry.section] = entry
        self:AddArtifactEntry(entry)
    end
    
    if #artifacts == 0 then
        -- Empty list, nothing to show
    end
end

--------------------------------------------------------------------------------
-- Get a human-readable name for an artifact
--------------------------------------------------------------------------------
function UIBerylDevice:GetArtifactDisplayName(obj, section)
    -- Use the section's localized name first (keys like st_af_generator_name)
    if section then
        local item_name = game.translate_string("st_" .. section .. "_name")
        if item_name and item_name ~= "" and item_name ~= "st_" .. section .. "_name" then
            return item_name
        end
    end
    
    -- Fallback to object name
    if obj then
        local name = obj:name()
        if name and name ~= "" then
            return name
        end
    end
    
    return section or "Unknown"
end

--------------------------------------------------------------------------------
-- Callbacks
--------------------------------------------------------------------------------

-- Charge button clicked
function UIBerylDevice:OnCharge()
    if not self.selected_data or not self.obj_id then return end
    
    self:Close()
    beryl_device.start_charging(self.obj_id, self.selected_data.section, self.selected_data.condition)
end

-- Close button clicked
function UIBerylDevice:OnClose()
    self:Close()
end

-- An artifact was clicked in the list
function UIBerylDevice:OnArtifactClicked()
    local selected = self.artifact_list:GetSelectedItem()
    if not selected then return end
    
    local section = selected.art_section
    if not section or section == "" then return end
    
    local entry = self.artifact_data[section]
    if entry then
        self.selected_data = entry
        pcall(function() self.btn_charge:Enable(true) end)
    end
end

--------------------------------------------------------------------------------
-- Update called every frame while dialog is shown
--------------------------------------------------------------------------------
function UIBerylDevice:Update()
    CUIScriptWnd.Update(self)
    self:UpdateStatusText()
end

--------------------------------------------------------------------------------
-- Close and cleanup
--------------------------------------------------------------------------------
function UIBerylDevice:Close()
    pcall(function()
        if self:IsShown() then
            self:HideDialog()
        end
        Unregister_UI("UIBerylDevice")
    end)
end

--------------------------------------------------------------------------------
-- Entry point: called from ui_on_interaction
--------------------------------------------------------------------------------
function start_dialog(obj_id)
    -- Guard against double-call from both ui_on_interaction and ui_on_simple_interaction
    if obj_id == last_interact_id and time_global() - last_interact_time < 100 then
        return
    end
    last_interact_id = obj_id
    last_interact_time = time_global()
    
    local state = beryl_device.get_device_state(obj_id)
    
    -- If charging, block UI - tip text already shows "charging" on the device
    if state == "charging" then
        return
    end
    
    -- Always try to return any pending artifact first, regardless of state
    local art_section, art_cond = beryl_device.get_artifact_info(obj_id)
    if art_section then
        beryl_device.return_artifact_to_player(obj_id)
        return
    end
    
    -- If still not idle (shouldn't happen after above checks), block UI
    if state ~= "idle" then
        return
    end
    
    if GUI == nil then
        GUI = UIBerylDevice()
    end
    
    if GUI:IsShown() then
        GUI:Close()
        GUI = UIBerylDevice()
    end
    
    GUI:TestAndShow(obj_id)
end
