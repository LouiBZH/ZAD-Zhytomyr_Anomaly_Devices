--[[
    Topaz Scanner - Perk Artefact Recharger

    Follows HF Gadgets pattern: 
    - State via hf_obj_manager (not wrapper variables)
    - Standalone functions for business logic
    - Wrapper only for update loop and physics

    State machine: idle → charging (60s) → cooldown → ready → idle
    (plus recharging → idle when an artefact is retrieved early)

    Cooldowns run on the IN-GAME clock, so sleeping, time skips, guides and
    fast travel all advance them. A global game-time watcher (see below)
    advances every device with a running cooldown, whether the device is
    online or not; the wrapper only reacts when the timer runs out.

    Whenever the device enters the idle state again, a news tip announces
    that it is ready to recharge, with its location relative to the nearest
    smart terrain: st_zad_topaz_idle_ready
    ("TOPAZ-1M Scanner <direction> of <smart> in <level> is now ready to
    recharge an artefact"). The tip is also delivered while the actor is on
    another level: the watcher finishes offline downtimes and the phrase then
    refers to the device's own level
]]

-- State helpers
local function get_data(obj_id)
    if not obj_id or not hf_obj_manager then return {} end
    return hf_obj_manager.get_data(obj_id) or {}
end

local function set_data(obj_id, fields)
    if not obj_id or not hf_obj_manager then return end
    hf_obj_manager.update_data(obj_id, fields)
end

local function get_actor()
    return db and db.actor or nil
end

--------------------------------------------------------------------------------
-- Game-clock cooldown advancement
-- Cooldowns must run on the in-game clock so sleeping, time skips, guides
-- and fast travel advance them. A global actor update watcher advances every
-- device with a running cooldown by the elapsed game seconds - whether the
-- device is online or not. Device ids are tracked while their countdown is
-- active; the tracker re-fills itself after a save load with a chunked
-- alife sweep so it never causes a hitch. When a countdown reaches zero on
-- an offline device, its downtime is finished here (see
-- finish_offline_downtime) so the ready notification works on any level
--------------------------------------------------------------------------------
local TOPAZ_PLACEABLE_SECTION = "placeable_zad_device_topaz"

local tracked_devices = {}    -- [device obj id] = true while a cooldown runs
local last_game_time = nil    -- game clock seen on the previous check
local last_watch_ms = 0       -- real-time throttle for the watcher
local rediscover_cursor = nil -- chunked alife sweep started after a load
local REDISCOVER_CHUNK = 500
local WATCH_INTERVAL_MS = 1000

local function game_time_now()
    local now = nil
    pcall(function() now = game.get_game_time() end)
    return now
end

local function device_data_safe(obj_id)
    local data = nil
    pcall(function() data = get_data(obj_id) end)
    return data or {}
end

local function advance_running_cooldowns()
    local now = game_time_now()
    if not now then return end

    if not last_game_time then
        last_game_time = now
        return
    end

    local elapsed = now:diffSec(last_game_time)
    last_game_time = now
    if elapsed <= 0 then return end

    for obj_id in pairs(tracked_devices) do
        local remaining = device_data_safe(obj_id).cooldown_timer
        if not remaining or remaining <= 0 then
            tracked_devices[obj_id] = nil
        else
            remaining = remaining - elapsed
            if remaining <= 0 then
                remaining = 0
                tracked_devices[obj_id] = nil
                -- Finish the downtime even when the device is offline, so
                -- the ready notification reaches the actor on any level
                finish_offline_downtime(obj_id)
            end
            pcall(function() set_data(obj_id, { cooldown_timer = remaining }) end)
        end
    end
end

local function process_rediscovery()
    if rediscover_cursor == nil then return end

    local sim = alife()
    if not sim then
        rediscover_cursor = nil
        return
    end

    local stop = rediscover_cursor + REDISCOVER_CHUNK - 1
    if stop > 65534 then stop = 65534 end

    for obj_id = rediscover_cursor, stop do
        local se = nil
        pcall(function() se = sim:object(obj_id) end)
        if se then
            local section = nil
            pcall(function() section = se:section_name() end)
            if section == TOPAZ_PLACEABLE_SECTION then
                local remaining = device_data_safe(obj_id).cooldown_timer
                if remaining and remaining > 0 then
                    tracked_devices[obj_id] = true
                end
            end
        end
    end

    rediscover_cursor = stop + 1
    if rediscover_cursor > 65534 then rediscover_cursor = nil end
end

local function on_cooldown_watch_update()
    process_rediscovery()

    local now_ms = time_global()
    if now_ms - last_watch_ms < WATCH_INTERVAL_MS then return end
    last_watch_ms = now_ms

    advance_running_cooldowns()
end

-- Display name of the current level (level names are string ids in Anomaly:
-- game.translate_string(level.name()) -> "Zaton")
local function get_level_display_name()
    local name = nil
    pcall(function() name = level.name() end)
    if type(name) ~= "string" or name == "" then return "the Zone" end

    local translated = nil
    pcall(function() translated = game.translate_string(name) end)
    if type(translated) == "string" and translated ~= "" and translated ~= name then
        return translated
    end
    return name
end

-- Returns the translated string for a string id, or nil when the id has no
-- translation (game.translate_string returns the id itself then)
local function translate_optional(str_id)
    if not str_id then return nil end

    local translated = nil
    pcall(function() translated = game.translate_string(str_id) end)
    if type(translated) == "string" and translated ~= "" and translated ~= str_id then
        return translated
    end
    return nil
end

local function actor_level_id()
    if not (db and db.actor and game_graph) then return nil end
    local ok, lvl = pcall(function()
        return game_graph():vertex(db.actor:game_vertex_id()):level_id()
    end)
    return ok and lvl or nil
end

-- 8-way compass strings for the nearest-smart location phrase
local DIRECTION_STRINGS = {
    "st_zad_dir_n", "st_zad_dir_ne", "st_zad_dir_e", "st_zad_dir_se",
    "st_zad_dir_s", "st_zad_dir_sw", "st_zad_dir_w", "st_zad_dir_nw",
}

-- Smarts farther than this (metres, 2D) are not used as a location
local MAX_SMART_DISTANCE = 250

-- Finds the nearest smart terrain to a position. target_lvl is the level id
-- the position belongs to - smarts of other levels use other-level
-- coordinates and are skipped (defaults to the actor's current level).
-- db.smart_terrain_by_id is filled by smart_terrain.script; the SIMBOARD
-- table is kept as a fallback for setups that do not provide it
local function get_nearest_smart(pos, target_lvl)
    if not pos then return nil end

    if not target_lvl then target_lvl = actor_level_id() end
    local best_sm, best_dist = nil, nil

    local function consider(sm)
        if not (sm and sm.position) then return end

        -- Smarts from other levels use other-level coordinates: skip them
        if target_lvl and game_graph and sm.m_game_vertex_id then
            local ok, lvl = pcall(function()
                return game_graph():vertex(sm.m_game_vertex_id):level_id()
            end)
            if ok and lvl and lvl ~= target_lvl then return end
        end

        local dx = sm.position.x - pos.x
        local dz = sm.position.z - pos.z
        local d = math.sqrt(dx * dx + dz * dz)
        if d > 0 and (not best_dist or d < best_dist) then
            best_dist = d
            best_sm = sm
        end
    end

    if db and type(db.smart_terrain_by_id) == "table" then
        for _, sm in pairs(db.smart_terrain_by_id) do
            consider(sm)
        end
    end
    if not best_sm and type(SIMBOARD) == "table" and type(SIMBOARD.smarts_by_names) == "table" then
        for _, sm in pairs(SIMBOARD.smarts_by_names) do
            consider(sm)
        end
    end

    if not best_sm or (best_dist and best_dist > MAX_SMART_DISTANCE) then return nil end
    return best_sm
end

-- "west" style direction from one point to another (8-way compass)
local function direction_of(from, to)
    if not (from and to) then return nil end

    local dx = (to.x or 0) - (from.x or 0)
    local dz = (to.z or 0) - (from.z or 0)
    if dx == 0 and dz == 0 then return nil end

    local ang = math.atan2(dx, dz) -- 0 = +z, pi/2 = +x
    if ang < 0 then ang = ang + 2 * math.pi end
    local sector = math.floor(ang / (math.pi / 4) + 0.5) % 8
    return translate_optional(DIRECTION_STRINGS[sector + 1])
end

-- Display name of a smart terrain: the localized smart-name table first
-- (get_smart_terrain_name from smart_terrain.script), then the raw name
local function smart_display_name(sm)
    if not sm then return nil end

    if type(get_smart_terrain_name) == "function" then
        local ok, name = pcall(get_smart_terrain_name, sm)
        if ok and type(name) == "string" and name ~= "" then
            return name
        end
    end

    local ok, name = pcall(function() return sm:name() end)
    if ok and type(name) == "string" and name ~= "" then
        return translate_optional(name) or name
    end

    return nil
end

-- Level id + display name of the level a placed device lives on, taken
-- from its server object, so it also works while the device is offline
-- (the actor being on another level)
local function get_object_level_info(obj_id)
    local lvl_id, lvl_name = nil, nil

    local se = nil
    pcall(function() se = alife():object(obj_id) end)
    if se then
        local gvid = nil
        pcall(function() gvid = se.m_game_vertex_id end)
        if gvid and game_graph then
            pcall(function() lvl_id = game_graph():vertex(gvid):level_id() end)
        end
    end

    if lvl_id and alife() then
        pcall(function() lvl_name = alife():level_name(lvl_id) end)
    end
    if type(lvl_name) ~= "string" or lvl_name == "" then lvl_name = nil end
    if lvl_name then lvl_name = translate_optional(lvl_name) or lvl_name end

    return lvl_id, lvl_name
end

-- Position of an offline device, read from its server object
local function get_server_position(obj_id)
    local pos = nil
    pcall(function() pos = alife():object(obj_id).position end)
    return pos
end

-- Human-readable location of the device, e.g. "west of the Station in
-- Zaton", or "in Zaton" when no smart terrain is near. lvl_id / lvl_name
-- are the device's own level, so the phrase stays correct when the actor
-- receives the notification while on another level
local function get_location_phrase(pos, lvl_id, lvl_name)
    local level_name = lvl_name or get_level_display_name()

    local sm = get_nearest_smart(pos, lvl_id)
    if sm then
        local name = smart_display_name(sm)
        -- The phrase reads "<device> is <direction> of <smart>", so the
        -- direction is computed FROM the smart TO the device
        local direction = direction_of(sm.position, pos)
        if name and direction then
            return string.format(game.translate_string("st_zad_topaz_loc_with_smart"), direction, name, level_name)
        end
    end

    return string.format(game.translate_string("st_zad_topaz_loc_level"), level_name)
end

--------------------------------------------------------------------------------
-- Business logic functions (standalone, called by wrapper & UI)
--------------------------------------------------------------------------------

function is_perk_artefact(item)
    if not item then return false end
    local ok_sec, section = pcall(function() return item:section() end)
    if not ok_sec or not section then return false end
    local kind = SYS_GetParam(0, section, "kind", "")
    return kind == "i_arty_junk"
end

function find_perk_artefacts_in_inventory()
    local actor = get_actor()
    if not actor then return {} end

    -- Build a set of belt item IDs
    local belt_ids = {}
    pcall(function()
        actor:iterate_belt(function(owner, arty)
            belt_ids[arty:id()] = true
        end)
    end)

    local result = {}
    
    pcall(function()
        actor:iterate_inventory(function(npc, item)
            if not item then return end
            if not is_perk_artefact(item) then return end
            
            local ok_sec, section = pcall(function() return item:section() end)
            if not ok_sec or not section then return end
            
            local ok_cond, condition = pcall(function() return item:condition() end)
            
            local on_belt = belt_ids[item:id()] == true
            table.insert(result, {
                object = item,
                section = section,
                condition = (ok_cond and condition) or 1.0,
                on_belt = on_belt
            })
        end, actor)
    end)
    
    return result
end

function get_device_state(obj_id)
    local data = get_data(obj_id)
    return data.device_state or "idle"
end

function get_artefact_info(obj_id)
    local data = get_data(obj_id)
    return data.artefact_section, data.original_condition
end

function get_cooldown_remaining(obj_id)
    local data = get_data(obj_id)
    return data.cooldown_timer or 0
end

function show_cooldown_message(obj_id)
    local actor = get_actor()
    if not actor then return end

    local hours = get_cooldown_remaining(obj_id) / 3600
    news_manager.send_tip(actor, string.format(game.translate_string("st_zad_topaz_cooldown"), hours), nil, nil, 30000)
end

-- Announces that the device finished its downtime and can charge again, e.g.
-- "TOPAZ-1M Scanner west of the Station in Zaton is now ready to recharge an artefact"
-- obj_id is used for the level / position, so the tip is also correct while
-- the actor is on another level and the device is offline
function show_idle_ready_tip(obj_id, device_pos)
    local actor = get_actor()
    if not actor then return end

    local lvl_id, lvl_name = nil, nil
    if obj_id then
        lvl_id, lvl_name = get_object_level_info(obj_id)
    end

    if not device_pos then
        device_pos = get_server_position(obj_id)
    end
    if not device_pos then return end

    local location = get_location_phrase(device_pos, lvl_id, lvl_name)
    news_manager.send_tip(actor, string.format(game.translate_string("st_zad_topaz_idle_ready"), location), nil, nil, 30000)
end

-- Completes a device's downtime while it is offline: the device becomes idle
-- again and the ready notification is delivered even when the actor is on
-- another level. Only the recharging state is finished here - the cooldown
-- state is completed by the wrapper when the device comes back online
function finish_offline_downtime(obj_id)
    if not obj_id then return end

    local data = device_data_safe(obj_id)
    if data.device_state ~= "recharging" then return end

    -- Online devices are handled by the wrapper (which also delays the
    -- notification so it does not collide with others), so leave them alone
    local online = false
    pcall(function() online = level.object_by_id(obj_id) ~= nil end)
    if online then return end

    pcall(function()
        set_data(obj_id, { device_state = "idle", cooldown_timer = 0 })
    end)

    show_idle_ready_tip(obj_id)
end

function start_charging(obj_id, section, condition, item_id)
    local actor = get_actor()
    if not section or not actor then return end

    -- Block charging if cooldown timer is still active (player retrieved early)
    local data = get_data(obj_id)
    if data.cooldown_timer and data.cooldown_timer > 0 then
        news_manager.send_tip(actor, game.translate_string("st_zad_topaz_cooldown"), nil, nil, 30000)
        return
    end

    -- Find the artefact first, then remove it (iterate_inventory breaks if
    -- you remove during iteration). The UI passes the exact item id, so with
    -- several copies of the same section the right one is consumed; the
    -- fallback matches by section + condition
    local found_item = nil
    actor:iterate_inventory(function(npc, item)
        if found_item then return end
        if not item then return end
        local ok, sec = pcall(function() return item:section() end)
        if not ok or sec ~= section then return end
        if item_id then
            local ok_id, id = pcall(function() return item:id() end)
            if not ok_id or id ~= item_id then return end
        elseif condition ~= nil and math.abs(item:condition() - condition) >= 0.01 then
            return
        end
        found_item = item
    end, actor)

    -- Never start charging without consuming the artefact (it would duplicate)
    if not found_item then
        news_manager.send_tip(actor, game.translate_string("st_zad_topaz_artefact_gone"), nil, nil, 30000)
        return
    end

    -- Release the item via its server object (remove_item doesn't exist in this engine)
    local se_obj = alife_object(found_item:id())
    if not se_obj then
        news_manager.send_tip(actor, game.translate_string("st_zad_topaz_artefact_gone"), nil, nil, 30000)
        return
    end
    alife():release(se_obj, true)

    set_data(obj_id, {
        device_state = "charging",
        charge_timer = 60,
        cooldown_timer = 0,
        artefact_section = section,
        original_condition = condition or 1.0
    })

    local obj = level.object_by_id(obj_id)
    if obj then
        local binder = obj:binded_object()
        if binder and binder.wrapper and binder.wrapper.start_charging_effects then
            binder.wrapper:start_charging_effects()
        end
    end
end

function return_artefact_to_player(obj_id, cond)
    local actor = get_actor()
    if not actor then return end

    local data = get_data(obj_id)
    local section = data.artefact_section
    if not section then return end

    local ret_cond = cond or 1.0
    alife_create_item(section, actor, {cond = ret_cond})

    -- Clean up anomalies before returning artefact
    local obj = level.object_by_id(obj_id)
    if obj then
        local binder = obj:binded_object()
        if binder and binder.wrapper and binder.wrapper.stop_charging_effects then
            binder.wrapper:stop_charging_effects()
        end
    end

    if hf_obj_manager then
        -- If the cooldown is still running, keep the device locked in "recharging"
        -- for the remaining time; otherwise it goes back to idle
        local remaining = data.cooldown_timer or 0
        local new_state = (remaining > 0) and "recharging" or "idle"
        hf_obj_manager.set_data(obj_id, {
            device_state = new_state,
            charge_timer = 0,
            cooldown_timer = remaining,
            artefact_section = nil,
            original_condition = nil
        })

        -- Entering idle: schedule the ready notification (it is delayed a
        -- moment so it does not collide with the retrieval tip sent below)
        if new_state == "idle" and obj then
            local binder = obj:binded_object()
            if binder and binder.wrapper and binder.wrapper.schedule_idle_ready_tip then
                binder.wrapper:schedule_idle_ready_tip()
            end
        end
    end

    if obj then
        obj:set_tip_text(game.translate_string("st_interact"))
    end

    -- Fail message if the artefact was not restored to full condition
    local msg_id = (ret_cond >= 1.0) and "st_zad_topaz_retrieved" or "st_zad_topaz_retrieved_fail"
    news_manager.send_tip(actor, game.translate_string(msg_id), nil, nil, 30000)
end

function get_anomaly_type_for_artefact(section)
    if not section then return "zone_mine_electric", "zone_field_radioactive" end

    local ini = system_ini()
    local det_particles = nil
    if ini then
        det_particles = ini:r_string_ex(section, "det_show_particles")
    end

    if not det_particles then return "zone_mine_electric", "zone_field_radioactive" end

    det_particles = string.lower(det_particles)

    if string.find(det_particles, "electra") then
        return "zone_mine_electra", "zone_field_radioactive_strong"
    elseif string.find(det_particles, "thermal") then
        return "zone_zharka_static_average", "zone_field_thermal_strong"
    elseif string.find(det_particles, "acidic") then
        return "zone_mine_chemical_average", "zone_field_acidic_strong"
    end

    return "zone_mine_electra", "zone_field_radioactive_strong"
end

--------------------------------------------------------------------------------
-- Init function for script_binding in LTX
--------------------------------------------------------------------------------
function init(obj)
    obj:bind_object(topaz_device_wrapper(obj).binder)
end

--------------------------------------------------------------------------------
-- Wrapper: handles update loop, physics, anomaly effects
-- Uses standard base_binder (via super(obj)) -- no custom binder,
-- interaction is handled entirely through ui_on_interaction LTX property.
--------------------------------------------------------------------------------
class "topaz_device_wrapper" (bind_hf_base.hf_binder_wrapper)

function topaz_device_wrapper:__init(obj) super(obj)

    self.anomaly_radius = 30
    self.anomaly_count = 30
    self.anomaly_ids = {}
    self.charge_sound = nil
    self.charge_sound_pos = nil
    self.cooldown_sound = nil
    self.charge_stage = 0
    self.field_spawned = false
    self.psy_spawned = false
    self.pending_idle_tip_at = nil

    local id = self.object:id()
    local data = get_data(id)
    if not data or not data.device_state then
        set_data(id, {
            device_state = "idle",
            charge_timer = 0,
            cooldown_timer = 0,
            artefact_section = nil,
            original_condition = nil
        })
    end

    self.object:set_tip_text(game.translate_string("st_interact"))
end

function topaz_device_wrapper:update(delta)
    -- Convert delta to seconds (engine passes milliseconds)
    local dt = delta
    if dt > 1.0 then dt = dt / 1000.0 end
    
    if not self.object then return end
    local id = self.object:id()
    local data = get_data(id)
    local state = data.device_state or "idle"

    -- Fire the scheduled idle notification once its delay has elapsed (the
    -- device must still be idle; skip it if a new charge already started)
    if self.pending_idle_tip_at and time_global() >= self.pending_idle_tip_at then
        self.pending_idle_tip_at = nil
        if state == "idle" then
            local pos = nil
            pcall(function() pos = self.object:position() end)
            show_idle_ready_tip(id, pos)
        end
    end

    -- Track devices with a running cooldown so the global watcher keeps
    -- advancing it on the game clock even when this device goes offline
    if data.cooldown_timer and data.cooldown_timer > 0 then
        tracked_devices[id] = true
    else
        tracked_devices[id] = nil
    end

    if state == "charging" then
        data.charge_timer = (data.charge_timer or 60) - dt

        -- Keep charge sound position synced with device position
        if self.charge_sound and self.charge_sound_pos then
            local current_pos = self.object:position()
            if current_pos then
                self.charge_sound_pos = current_pos
                pcall(function() self.charge_sound:set_position(current_pos) end)
            end
        end

        -- Staged anomaly mine spawning, field zone spawns last at t=30
        if self.charge_stage < 6 and data.charge_timer <= 60 - (self.charge_stage + 1) * 5 then
            self:spawn_charge_stage(self.charge_stage)
            self.charge_stage = self.charge_stage + 1
        elseif self.charge_stage == 6 and data.charge_timer <= 30 and not self.field_spawned then
            self:spawn_field_zone()
        end

        if data.charge_timer <= 0 then
            local orig_cond = data.original_condition or 1.0
            local cooldown = 43200 + (1 - orig_cond) * 43200  -- 12h at 100%, 24h at 0%

            local actor = get_actor()
            if actor then
                local hours = cooldown / 3600
                news_manager.send_tip(actor, string.format(game.translate_string("st_zad_topaz_retrieve_timer"), hours), nil, nil, 30000)
            end

            set_data(id, {
                device_state = "cooldown",
                charge_timer = 0,
                cooldown_timer = cooldown,
                artefact_section = data.artefact_section,
                original_condition = orig_cond
            })

            -- Stop charge sound, start cooldown loop sound
            if self.charge_sound then
                pcall(function() self.charge_sound:stop() end)
                self.charge_sound = nil
                self.charge_sound_pos = nil
            end
            local cpos = self.object:position()
            if cpos then
                local ok_cd, cd_snd = pcall(function() return sound_object("zad\\topaz_cd") end)
                if ok_cd and cd_snd then
                    self.cooldown_sound = cd_snd
                    pcall(function()
                        self.cooldown_sound:play_at_pos(self.object, cpos, 0, sound_object.looped)
                        self.cooldown_sound.volume = 1.0
                    end)
                end
            end

            self.object:set_tip_text(game.translate_string("st_zad_topaz_cooldown"))
        else
            set_data(id, { charge_timer = data.charge_timer })
        end

    elseif state == "cooldown" then
        -- The remaining time is advanced on the game clock by the global
        -- watcher (so sleeping and other time skips count); here we only
        -- react when it has run out
        local remaining = data.cooldown_timer or 0

        -- Keep cooldown sound position synced with device position
        if self.cooldown_sound then
            local current_pos = self.object:position()
            if current_pos then
                pcall(function() self.cooldown_sound:set_position(current_pos) end)
            end
        end

        if remaining <= 0 then
            -- Cooldown over, clean up anomalies and ready for manual retrieval
            self:stop_charging_effects()
            set_data(id, {
                device_state = "ready",
                charge_timer = 0,
                cooldown_timer = 0,
                artefact_section = data.artefact_section,
                original_condition = data.original_condition
            })
            tracked_devices[id] = nil

            self.object:set_tip_text(game.translate_string("st_zad_topaz_retrieve"))
        end

    elseif state == "recharging" then
        -- Same as above: this timer is advanced by the game-clock watcher
        local remaining = data.cooldown_timer or 0

        if remaining <= 0 then
            -- Downtime over: device is idle again
            set_data(id, {
                device_state = "idle",
                cooldown_timer = 0
            })
            tracked_devices[id] = nil
            self:schedule_idle_ready_tip()
        end
    end
end

-- Schedules the "ready to recharge" notification shortly after the device
-- enters idle, so it does not collide with other tips sent the same moment
function topaz_device_wrapper:schedule_idle_ready_tip()
    self.pending_idle_tip_at = time_global() + 1500
end

function topaz_device_wrapper:start_charging_effects()
    local device_pos = self.object:position()

    -- Start the looping charge sound
    if device_pos then
        local ok_snd, snd = pcall(function() return sound_object("zad\\topaz_charging") end)
        if ok_snd and snd then
            self.charge_sound = snd
            self.charge_sound_pos = device_pos
            pcall(function()
                self.charge_sound:play_at_pos(self.object, device_pos, 0, sound_object.looped)
                self.charge_sound.volume = 1.0
            end)
        end
    end

    -- Reset staged anomaly spawning tracking
    self.charge_stage = 0
    self.field_spawned = false
    self.psy_spawned = false

    -- Spawn psy field right on top of the device
    self:spawn_psy_field()

    pcall(function() self.object:set_tip_text(game.translate_string("st_zad_topaz_charging")) end)
end

--------------------------------------------------------------------------------
-- Spawn anomalies for a specific ring stage (2m min offset from device)
-- stage 0: 2-7m, 1: 7-12m, 2: 12-17m, 3: 17-22m, 4: 22-27m, 5: 27-32m
--------------------------------------------------------------------------------
function topaz_device_wrapper:spawn_charge_stage(stage)
    local device_pos = self.object:position()
    if not device_pos then return end

    local alife_obj = alife()
    if not alife_obj then return end

    local data = get_data(self.object:id())
    local primary_type, _ = get_anomaly_type_for_artefact(data.artefact_section)

    local lvid = level.vertex_id(device_pos)
    local gvid = self.object:game_vertex_id()

    local inner_radius = stage * 5 + 2
    local outer_radius = (stage + 1) * 5 + 2

    -- Helper to spawn an anomaly with proper zone data (required to prevent nearest_s crash in CalcDistanceTo)
    local function spawn_anom(anom_type, pos, spawn_lvid)
        if SYS_GetParam(0, anom_type, "class", "") == "" then return nil end

        local se_obj = alife_obj:create(anom_type, pos, spawn_lvid, gvid)
        if not se_obj then return nil end

        -- Set zone data (required to prevent nearest_s crash in CalcDistanceTo)
        pcall(function()
            local zdata = utils_stpk.get_anom_zone_data(se_obj)
            if zdata then
                zdata.shapes[1] = zdata.shapes[1] or {}
                zdata.shapes[1].shtype = 0
                zdata.shapes[1].offset = vector():set(0, 0, 0)
                zdata.shapes[1].center = vector():set(0, 0, 0)
                zdata.shapes[1].radius = 2.0 + math.random() * 2.0
                utils_stpk.set_anom_zone_data(zdata, se_obj)
            end
        end)

        return se_obj
    end

    -- Elemental count per stage: 1,2,4,5,8,9
    local elem_count = ({1, 2, 4, 5, 8, 9})[stage + 1] or 1
    for i = 1, elem_count do
        local angle = (i / elem_count) * 2 * math.pi + math.random() * 0.3
        local dist = inner_radius + math.random() * (outer_radius - inner_radius)

        local pos = vector():set(
            device_pos.x + math.cos(angle) * dist,
            device_pos.y,
            device_pos.z + math.sin(angle) * dist
        )

        local spawn_lvid = level.vertex_id(pos)
        if spawn_lvid == 65535 then spawn_lvid = lvid end

        local vertex_pos = level.vertex_position(spawn_lvid)
        if vertex_pos then
            pos.y = vertex_pos.y
        end

        local se_obj = spawn_anom(primary_type, pos, spawn_lvid)
        if se_obj then
            table.insert(self.anomaly_ids, se_obj.id)
        end
    end

    -- Gravitational count per stage: 1,2,3,4,4,5
    local grav_count = ({1, 2, 3, 4, 4, 5})[stage + 1] or 1
    for i = 1, grav_count do
        local angle = (i / grav_count) * 2 * math.pi + math.random() * 0.5
        local dist = inner_radius + math.random() * (outer_radius - inner_radius)

        local grav_type = (stage % 2 == 0)
            and "zone_mine_springboard"
            or "zone_mine_vortex"

        local pos = vector():set(
            device_pos.x + math.cos(angle) * dist,
            device_pos.y,
            device_pos.z + math.sin(angle) * dist
        )

        local spawn_lvid = level.vertex_id(pos)
        if spawn_lvid == 65535 then spawn_lvid = lvid end

        local vertex_pos = level.vertex_position(spawn_lvid)
        if vertex_pos then
            pos.y = vertex_pos.y
        end

        local se_obj = spawn_anom(grav_type, pos, spawn_lvid)
        if se_obj then
            table.insert(self.anomaly_ids, se_obj.id)
        end
    end
end

--------------------------------------------------------------------------------
-- Spawn the field zone at device position (triggered at t=30)
--------------------------------------------------------------------------------
function topaz_device_wrapper:spawn_field_zone()
    local device_pos = self.object:position()
    if not device_pos then return end

    local alife_obj = alife()
    if not alife_obj then return end

    local data = get_data(self.object:id())
    local _, field_type = get_anomaly_type_for_artefact(data.artefact_section)

    local lvid = level.vertex_id(device_pos)
    local gvid = self.object:game_vertex_id()

    -- Adjust field zone Y to ground level
    local field_pos = vector():set(device_pos.x, device_pos.y, device_pos.z)
    pcall(function()
        local fv_pos = level.vertex_position(lvid)
        if fv_pos then
            field_pos.y = fv_pos.y
        end
    end)

    if SYS_GetParam(0, field_type, "class", "") == "" then return end

    local se_field = alife_obj:create(field_type, field_pos, lvid, gvid)
    if not se_field then return end

    -- Fully initialize zone shape data (required to prevent nearest_s crash in CalcDistanceTo)
    pcall(function()
        local zdata = utils_stpk.get_anom_zone_data(se_field)
        if zdata then
            zdata.shapes[1] = zdata.shapes[1] or {}
            zdata.shapes[1].shtype = 0
            zdata.shapes[1].offset = vector():set(0, 0, 0)
            zdata.shapes[1].center = vector():set(0, 0, 0)
            zdata.shapes[1].radius = 32.0
            utils_stpk.set_anom_zone_data(zdata, se_field)
        end
    end)

    table.insert(self.anomaly_ids, se_field.id)
    self.field_spawned = true
end

--------------------------------------------------------------------------------
-- Spawn psy field anomaly right on top of the device
--------------------------------------------------------------------------------
function topaz_device_wrapper:spawn_psy_field()
    local device_pos = self.object:position()
    if not device_pos then return end

    local alife_obj = alife()
    if not alife_obj then return end

    local lvid = level.vertex_id(device_pos)
    local gvid = self.object:game_vertex_id()

    -- Adjust psy field Y to ground level
    local psy_pos = vector():set(device_pos.x, device_pos.y, device_pos.z)
    pcall(function()
        local v_pos = level.vertex_position(lvid)
        if v_pos then
            psy_pos.y = v_pos.y
        end
    end)

    local psy_type = "zone_field_psychic_weak"
    if SYS_GetParam(0, psy_type, "class", "") == "" then return end

    local se_psy = alife_obj:create(psy_type, psy_pos, lvid, gvid)
    if not se_psy then return end

    -- Initialize zone shape data
    pcall(function()
        local zdata = utils_stpk.get_anom_zone_data(se_psy)
        if zdata then
            zdata.shapes[1] = zdata.shapes[1] or {}
            zdata.shapes[1].shtype = 0
            zdata.shapes[1].offset = vector():set(0, 0, 0)
            zdata.shapes[1].center = vector():set(0, 0, 0)
            zdata.shapes[1].radius = 1.0
            utils_stpk.set_anom_zone_data(zdata, se_psy)
        end
    end)

    table.insert(self.anomaly_ids, se_psy.id)
    self.psy_spawned = true
end

function topaz_device_wrapper:stop_charging_effects()
    -- Disable anomalies via game object (matching DAO pattern), then release
    local alife_obj = alife()
    for _, id in ipairs(self.anomaly_ids) do
        -- First disable via game object (disable_anomaly exists on game_object, not server)
        local g_obj = level.object_by_id(id)
        if g_obj then
            pcall(function() g_obj:disable_anomaly() end)
        end
        -- Then release via server object
        if alife_obj then
            local se_obj = alife_obj:object(id)
            if se_obj then
                pcall(function() alife_obj:release(se_obj, true) end)
            end
        end
    end
    self.anomaly_ids = {}

    if self.charge_sound then
        pcall(function() self.charge_sound:stop() end)
        self.charge_sound = nil
        self.charge_sound_pos = nil
    end

    if self.cooldown_sound then
        pcall(function() self.cooldown_sound:stop() end)
        self.cooldown_sound = nil
    end
end

function topaz_device_wrapper:play_sound(path)
    local ok, snd = pcall(function() return sound_object(path) end)
    if ok and snd then
        local pos = self.object:position()
        if pos then
            pcall(function() snd:play_at_pos(self.object, pos, 0, sound_object.s3d) end)
        end
    end
    return ok and snd or nil
end

function topaz_device_wrapper:net_spawn(se_abstract)
    if not self.object then return false end
    local ok = true
    if bind_hf_base.hf_binder_wrapper.net_spawn then
        ok = bind_hf_base.hf_binder_wrapper.net_spawn(self, se_abstract)
        if ok == false then return false end
    end

    local phys = self.object:get_physics_shell()
    if phys then phys:freeze() end

    return true
end

function topaz_device_wrapper:net_destroy()
    if not self.object then return end

    -- If the device goes offline with a countdown running, keep it tracked so
    -- the game-clock watcher can keep advancing it in the background
    local id = self.object:id()
    local data = device_data_safe(id)
    if data.cooldown_timer and data.cooldown_timer > 0 then
        tracked_devices[id] = true
    end

    self:stop_charging_effects()

    if bind_hf_base.hf_binder_wrapper.net_destroy then
        bind_hf_base.hf_binder_wrapper.net_destroy(self)
    end
end

--------------------------------------------------------------------------------
-- Prevent pickup while charging or when an artefact hasn't been retrieved
--------------------------------------------------------------------------------
function topaz_device_wrapper:pickup()
    local id = self.object:id()
    local data = get_data(id)
    local state = data.device_state or "idle"
    
    -- Cannot pick up while charging
    if state == "charging" then
        if db.actor then
            news_manager.send_tip(db.actor, game.translate_string("st_zad_topaz_charging"), nil, nil, 30000)
        end
        return false
    end

    -- Cannot pick up while recharging (early retrieval: cooldown still running)
    if state == "recharging" then
        show_cooldown_message(id)
        return false
    end
    
    -- Cannot pick up if there's an artefact waiting to be retrieved
    if data.artefact_section then
        if db.actor then
            news_manager.send_tip(db.actor, game.translate_string("st_zad_topaz_retrieve"), nil, nil, 30000)
        end
        return false
    end
    
    -- Clean up any active effects before pickup
    self:stop_charging_effects()
    
    -- Call parent pickup
    return bind_hf_base.hf_binder_wrapper.pickup(self)
end

--------------------------------------------------------------------------------
-- Entry points
--------------------------------------------------------------------------------
function on_game_start()
    -- Track cooldowns of placed devices after every save load: the tracker
    -- lives in script memory, so it starts empty and sweeps the alife
    -- (chunked) to find devices that still have a countdown running
    rediscover_cursor = 1

    RegisterScriptCallback("actor_on_update", on_cooldown_watch_update)
    RegisterScriptCallback("load_state", function()
        rediscover_cursor = 1
    end)
end
