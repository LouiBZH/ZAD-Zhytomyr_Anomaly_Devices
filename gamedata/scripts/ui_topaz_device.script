--[[
    UI Topaz Device - Interaction dialog for Topaz Scanner
    - Artefact list shown directly on open
    - "Charge Artefact" button at bottom
    - "Close" button at bottom
    - No pick up button (handled by game)
]]

local GUI = nil  -- singleton

--------------------------------------------------------------------------------
-- Color helper: condition (0.0–1.0) → ARGB color
-- Gradient: red → orange → yellow → green
--------------------------------------------------------------------------------
local function condition_to_color(condition)
    local t = math.max(0, math.min(1, condition))

    local r, g, b

    if t <= 0.333 then
        -- Red → Orange  (0% – 33%)
        local s = t / 0.333
        r = 255
        g = math.floor(165 * s)
        b = 0
    elseif t <= 0.666 then
        -- Orange → Yellow  (33% – 66%)
        local s = (t - 0.333) / 0.333
        r = 255
        g = math.floor(165 + (255 - 165) * s)
        b = 0
    else
        -- Yellow → Green  (66% – 100%)
        local s = (t - 0.666) / 0.334
        r = math.floor(255 * (1 - s))
        g = 255
        b = 0
    end

    return 0xFF000000 + r * 65536 + g * 256 + b
end

--------------------------------------------------------------------------------
-- Main UI class
--------------------------------------------------------------------------------
class "UITopazDevice" (CUIScriptWnd)

function UITopazDevice:__init() super()
    self.obj_id = nil
    self.selected_data = nil
    self.artefact_data = {}  -- section -> {section, condition, object}
    
    self:InitControls()
    self:InitCallbacks()
end

function UITopazDevice:__finalize()
    GUI = nil
end

--------------------------------------------------------------------------------
-- Initialize all UI controls from XML
--------------------------------------------------------------------------------
function UITopazDevice:InitControls()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)
    
    local xml = CScriptXmlInit()
    xml:ParseFile("ui_topaz_device_dialog")
    
    self.back = xml:InitFrame("background", self)
    self.title_text = xml:InitStatic("title_text", self.back)
    self.status_text = xml:InitStatic("status_text", self.back)
    self.list_frame = xml:InitFrame("list_frame", self.back)
    self.artefact_list = xml:InitListBox("artefact_list", self.list_frame)
    self:Register(self.artefact_list, "artefact_list")
    
    self.btn_charge = xml:Init3tButton("btn_charge", self.back)
    self:Register(self.btn_charge, "btn_charge")
    
    self.btn_close = xml:Init3tButton("btn_close", self.back)
    self:Register(self.btn_close, "btn_close")
end

--------------------------------------------------------------------------------
-- Register button callbacks
--------------------------------------------------------------------------------
function UITopazDevice:InitCallbacks()
    self:AddCallback("btn_charge", ui_events.BUTTON_CLICKED, 
        self.OnCharge, self)
    self:AddCallback("btn_close", ui_events.BUTTON_CLICKED, 
        self.OnClose, self)
    self:AddCallback("artefact_list", ui_events.LIST_ITEM_CLICKED, 
        self.OnArtefactClicked, self)
end

--------------------------------------------------------------------------------
-- Keyboard handler (ESC to close)
--------------------------------------------------------------------------------
function UITopazDevice:OnKeyboard(dik, keyboard_action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
    if res == false then
        if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
            if dik == DIK_keys.DIK_ESCAPE then
                self:Close()
                return true
            end
        end
    end
    return res
end

--------------------------------------------------------------------------------
-- Show the dialog
--------------------------------------------------------------------------------
function UITopazDevice:TestAndShow(obj_id)
    self.obj_id = obj_id
    self.selected_data = nil
    
    -- Update status text
    self:UpdateStatusText()
    
    -- Populate artefact list
    self:PopulateArtefactList()
    
    -- Disable charge button until artefact selected
    pcall(function() self.btn_charge:Enable(false) end)
    
    pcall(function() self:ShowDialog(true) end)
    pcall(function() Register_UI("UITopazDevice", "ui_topaz_device") end)
end

--------------------------------------------------------------------------------
-- Update status text based on current device state
--------------------------------------------------------------------------------
function UITopazDevice:UpdateStatusText()
    if not self.obj_id then return end
    
    local state = topaz_device.get_device_state(self.obj_id)
    local text_id = "st_zad_topaz_ui_status_idle"
    
    if state == "charging" then
        text_id = "st_zad_topaz_ui_status_charging"
    elseif state == "cooldown" then
        text_id = "st_zad_topaz_ui_status_cooldown"
    elseif state == "ready" then
        text_id = "st_zad_topaz_ui_status_ready"
    end
    
    pcall(function() self.status_text:SetText(game.translate_string(text_id)) end)
end

--------------------------------------------------------------------------------
-- Custom list item class
--------------------------------------------------------------------------------
class "artefact_item" (CUIListBoxItem)

function artefact_item:__init(height) super(height)
    self.art_section = nil
    self.art_entry = nil
    self.txt = self:GetTextItem()
    self.txt:SetFont(GetFontLetterica16Russian())
    self.txt:SetEllipsis(true)
end

function artefact_item:__finalize()
end

function UITopazDevice:AddArtefactEntry(entry)
    local item = artefact_item(22)
    item:SetWndSize(vector2():set(400, 22))
    item.art_section = entry.section
    item.art_entry = entry  -- exact entry for this row (same section may repeat)

    local art_name = self:GetArtefactDisplayName(entry.object, entry.section)
    local condition_pct = math.floor(entry.condition * 100)
    local prefix = entry.on_belt and "[BELT] " or ""
    local txt = prefix .. art_name .. " [" .. condition_pct .. "%]"
    
    item.txt:SetWndPos(vector2():set(0, 0))
    item.txt:SetWndSize(vector2():set(400, 22))
    pcall(function() item.txt:SetText(txt) end)

    -- Set text color based on artefact condition
    local color = condition_to_color(entry.condition)
    pcall(function() item.txt:SetTextColor(color) end)

    self.artefact_list:AddExistingItem(item)
end

--------------------------------------------------------------------------------
-- Populate artefact list
--------------------------------------------------------------------------------
function UITopazDevice:PopulateArtefactList()
    self.artefact_list:RemoveAll()
    self.selected_data = nil
    self.artefact_data = {}
    
    local artefacts = topaz_device.find_perk_artefacts_in_inventory() or {}
    
    -- Sort: belt artefacts first, then by condition descending
    table.sort(artefacts, function(a, b)
        if a.on_belt ~= b.on_belt then
            return a.on_belt  -- belt artefacts come first
        end
        return a.condition > b.condition  -- highest condition first
    end)
    
    for _, entry in ipairs(artefacts) do
        self.artefact_data[entry.section] = entry
        self:AddArtefactEntry(entry)
    end
    
    if #artefacts == 0 then
        -- Empty list, nothing to show
    end
end

--------------------------------------------------------------------------------
-- Get a human-readable name for an artefact
--------------------------------------------------------------------------------
function UITopazDevice:GetArtefactDisplayName(obj, section)
    -- Use the section's localized name first (keys like st_af_generator_name)
    if section then
        local item_name = game.translate_string("st_" .. section .. "_name")
        if item_name and item_name ~= "" and item_name ~= "st_" .. section .. "_name" then
            return item_name
        end
    end
    
    -- Fallback to object name
    if obj then
        local name = obj:name()
        if name and name ~= "" then
            return name
        end
    end
    
    return section or "Unknown"
end

--------------------------------------------------------------------------------
-- Callbacks
--------------------------------------------------------------------------------

-- Charge button clicked
function UITopazDevice:OnCharge()
    if not self.selected_data or not self.obj_id then return end
    
    self:Close()
    topaz_device.start_charging(self.obj_id, self.selected_data.section, self.selected_data.condition)
end

-- Close button clicked
function UITopazDevice:OnClose()
    self:Close()
end

-- An artefact was clicked in the list
function UITopazDevice:OnArtefactClicked()
    local selected = self.artefact_list:GetSelectedItem()
    if not selected then return end
    
    local section = selected.art_section
    if not section or section == "" then return end
    -- Use the entry bound to this exact row: the same section can appear
    -- multiple times with different conditions
    local entry = selected.art_entry or self.artefact_data[section]
    if entry then
        -- An artefact already at full condition cannot be recharged
        local is_full = entry.condition >= 1.0
        if is_full then
            self.selected_data = nil
        else
            self.selected_data = entry
        end
        pcall(function() self.btn_charge:Enable(not is_full) end)
    end
end

--------------------------------------------------------------------------------
-- Update called every frame while dialog is shown
--------------------------------------------------------------------------------
function UITopazDevice:Update()
    CUIScriptWnd.Update(self)
    self:UpdateStatusText()
end

--------------------------------------------------------------------------------
-- Close and cleanup
--------------------------------------------------------------------------------
function UITopazDevice:Close()
    pcall(function()
        if self:IsShown() then
            self:HideDialog()
        end
        Unregister_UI("UITopazDevice")
    end)
end

--------------------------------------------------------------------------------
-- Entry point: called from ui_on_interaction
--------------------------------------------------------------------------------
function start_dialog(obj_id)
    local state = topaz_device.get_device_state(obj_id)
    
    -- If charging, block UI - tip text already shows "charging" on the device
    if state == "charging" then
        return
    end

    -- If recharging (artefact already retrieved, cooldown still running),
    -- only show the remaining cooldown time - no UI
    if state == "recharging" then
        topaz_device.show_cooldown_message(obj_id)
        return
    end
    
    -- Always try to return any pending artefact first, regardless of state
    local art_section, art_cond = topaz_device.get_artefact_info(obj_id)
    if art_section then
        -- If cooldown finished (ready state), return at original condition; otherwise full charge
        local ret_cond = (state == "ready") and art_cond or nil
        topaz_device.return_artefact_to_player(obj_id, ret_cond)
        return
    end
    
    -- If still not idle (shouldn't happen after above checks), block UI
    if state ~= "idle" then
        return
    end
    
    if GUI == nil then
        GUI = UITopazDevice()
    end
    
    if GUI:IsShown() then
        GUI:Close()
        GUI = UITopazDevice()
    end
    
    GUI:TestAndShow(obj_id)
end
