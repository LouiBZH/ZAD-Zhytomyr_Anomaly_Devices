	</string>
	<string id="st_zad_topaz_select_header">
		<text>Select a perk artefact to recharge:</text>
	</string>
	<string id="st_zad_topaz_charge_artefact">
		<text>Charge Artefact</text>
	</string>
	<string id="st_zad_topaz_ui_status_idle">
		<text>Device ready. Select an artefact to start the scanning process.</text>
	</string>
	<string id="st_zad_topaz_ui_status_charging">
		<text>Device is charging. Please wait...</text>
	</string>
	<string id="st_zad_topaz_ui_status_cooldown">
