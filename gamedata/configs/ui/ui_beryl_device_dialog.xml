	<!-- Device Title -->
	<title_text x="0" y="8" width="1024" height="24" align="c">
		<text font="letterica25">st_zad_device_beryl_name</text>
	</title_text>

	<!-- Status text -->
	<status_text x="0" y="36" width="1024" height="20" align="c">
		<text font="letterica18">st_zad_beryl_ui_status_idle</text>
	</status_text>

	<!-- Main mode: Select Artifact button -->
	<btn_select_artifact x="78" y="90" width="214" height="28" check_mode="0" stretch="1">
