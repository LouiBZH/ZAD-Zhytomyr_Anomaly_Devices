	<btn_cancel_select x="78" y="240" width="214" height="28" check_mode="0" stretch="1">
		<window_name>button_cancel_select</window_name>
		<text font="letterica18">st_cancel</text>
		<texture>ui_button_ordinary</texture>
	</btn_cancel_select>

	<!-- Selection mode: Header text for list -->
	<select_header x="0" y="52" width="1024" height="20" align="c">
		<text font="letterica18">st_zad_beryl_select_header</text>
