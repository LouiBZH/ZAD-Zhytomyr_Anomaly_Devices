;===============================================================================
; ZAD Devices - Item configurations
;===============================================================================
; Uses E_DEVICE class (engine-native CCustomDevice) for inventory items.
; HF placeable sections are provided for integration with hideout furniture mod.
;===============================================================================

;===============================================================================
; INVENTORY ITEMS (carried in backpack)
;===============================================================================

; Topaz Device
[zad_device_topaz]:identity_immunities
GroupControlSection	= spawn_section
discovery_dependency	=
$spawn					= "devices\zad_device_topaz"
class					= E_DEVICE
cform					= skeleton
visual					= equipments\devices\radio\radio.ogf
inv_name				= st_zad_device_topaz_name
inv_name_short			= st_zad_device_topaz_short
description				= st_zad_device_topaz_desc
inv_weight				= 1.0
inv_grid_width			= 2
inv_grid_height			= 2
inv_grid_x				= 0
inv_grid_y				= 0
cost					= 5000
condition_shot_count	= 0
animation_slot			= 1
repairs_mode			= 1

; --- HF placement fields (requires hideout furniture mod) ---
placeable_section		= placeable_zad_device_topaz

