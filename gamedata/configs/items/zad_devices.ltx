;===============================================================================
; ZAD Devices - Item configurations
;===============================================================================
; Inventory items use class = II_ATTACH (same as HF furniture) for tools category.
; Placed world objects use script_binding for device logic (requires HF mod).
;===============================================================================

;===============================================================================
; INVENTORY ITEMS (carried in backpack, placeable via HF)
;===============================================================================

; Topaz Device
[zad_device_topaz]
GroupControlSection	= spawn_section
discovery_dependency	=
$spawn					= "tools\zad_device_topaz"
class					= II_ATTACH
cform					= skeleton
visual					= dynamics\equipments\trade\radio.ogf
inv_name				= st_zad_device_topaz_name
inv_name_short			= st_zad_device_topaz_short
description				= st_zad_device_topaz_desc
inv_weight				= 1.0
inv_grid_width			= 2
inv_grid_height			= 2
inv_grid_x				= 0
inv_grid_y				= 0
cost					= 5000
condition_shot_count	= 0
animation_slot			= 1
repairs_mode			= 1
placeable_section		= placeable_zad_device_topaz

