;===============================================================================
; ZAD Devices - Item configurations
;===============================================================================
; Inventory items use class = II_ATTACH (HF furniture standard).
; Place via right-click → use1_functor (hideout furniture placement).
; Placed objects use script_binding for device logic.
;===============================================================================

; Topaz Device (inventory item)
[zad_device_topaz]:tch_junk
$spawn									= "zad_device_topaz"
class									= II_ATTACH
kind									= i_tool
visual									= dynamics\equipments\trade\radio.ogf
inv_name								= st_zad_device_topaz_name
inv_name_short							= st_zad_device_topaz_short
description								= st_zad_device_topaz_desc
inv_weight								= 1.0
inv_grid_width							= 2
inv_grid_height							= 2
inv_grid_x								= 0
inv_grid_y								= 0
cost									= 5000
icons_texture							= ui\placeable_devices
use1_functor							= placeable_furniture.place_item
use1_action_functor						= placeable_furniture.func_place_item
placeable_type							= device
placeable_section						= placeable_zad_device_topaz

