;===============================================================================
; PLACED WORLD OBJECTS (requires hideout furniture mod)
;===============================================================================

; Topaz Device (placed) - Placeholder
[placeable_zad_device_topaz]:physic_object
visual					= dynamics\equipments\trade\radio.ogf
inv_weight				= 1.0
script_binding			= bind_hf_base.init
item_section			= zad_device_topaz
