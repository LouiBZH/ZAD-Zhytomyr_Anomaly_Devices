;===============================================================================
; ZAD Devices - Trade configurations
; Uses Hideout Furniture trade system format (GAMMA compatible)
;===============================================================================

; Beryl Device - Sold by Ecologists (anomaly/artifact specialists)
[zad_trade_beryl_ecolog]
items				= zad_device_beryl
factions			= ecolog
min_supply_level	= 1
amount				= 1

; Beryl Device - Sold by Mechanics (tech items)
[zad_trade_beryl_mechanic]
items				= zad_device_beryl
factions			= dolg, army, freedom, stalker
min_supply_level	= 2
amount				= 1

